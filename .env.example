# ==================== FRONTEND ====================
NODE_ENV=production
ANGULAR_API_URL=http://localhost:8000/api
KEYCLOAK_URL=http://localhost:8180

# ==================== IDENTITY & SECURITY (Keycloak) ====================
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak123
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# ==================== GATEWAY SERVICE ====================
GATEWAY_DB_PASSWORD=gateway123
GATEWAY_REDIS_HOST=redis
GATEWAY_REDIS_PORT=6379

# ==================== USER SERVICE ====================
USER_DB_PASSWORD=user123

# ==================== ORDER SERVICE ====================
ORDER_DB_PASSWORD=order123
GRPC_ORDER_SERVICE_PORT=50051

# ==================== FILE SERVICE ====================
FILE_DB_PASSWORD=file123
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ==================== NOTIFICATION SERVICE ====================
NOTIFICATION_DB_PASSWORD=notification123
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@microservice.com

# ==================== AUDIT LOG SERVICE ====================
AUDIT_DB_PASSWORD=audit123

# ==================== MESSAGING & STREAMING ====================
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_TOPIC_PREFIX=microservice

# ==================== CACHE ====================
REDIS_PASSWORD=redis123
REDIS_HOST=redis
REDIS_PORT=6379

# ==================== STORAGE (MinIO) ====================
MINIO_URL=http://minio:9000
MINIO_CONSOLE_URL=http://localhost:9001

# ==================== DOCKER REGISTRY ====================
DOCKER_REGISTRY_URL=localhost:5000
DOCKER_REGISTRY_USERNAME=admin
DOCKER_REGISTRY_PASSWORD=registry123

# ==================== JENKINS ====================
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=admin123
JENKINS_JAVA_OPTS=-Xmx512m -Xms256m

# ==================== OBSERVABILITY ====================
PROMETHEUS_RETENTION_DAYS=15
PROMETHEUS_SCRAPE_INTERVAL=15s

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123
GRAFANA_ADMIN_EMAIL=admin@example.com

# ==================== APPLICATION ====================
APP_NAME=microservice-platform
APP_VERSION=1.0.0
APP_ENVIRONMENT=development

# ==================== JWT & Security ====================
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24

# ==================== LOGGING ====================
LOG_LEVEL=INFO
LOG_FORMAT=json

