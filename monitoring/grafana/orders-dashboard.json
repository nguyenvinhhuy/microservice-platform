{
  "uid": "orders-dashboard",
  "title": "Orders Dashboard",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Orders Created / Failed (rate)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(orders_created_total[5m]))", "legendFormat": "created" },
        { "expr": "sum(rate(orders_failed_total[5m]))", "legendFormat": "failed" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Inventory Reservation Latency (avg seconds)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(inventory_reservation_latency_seconds_sum[5m]) / rate(inventory_reservation_latency_seconds_count[5m])",
          "legendFormat": "avg"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Payment Latency (avg seconds)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(payment_latency_seconds_sum[5m]) / rate(payment_latency_seconds_count[5m])",
          "legendFormat": "avg"
        }
      ]
    }
  ]
}

