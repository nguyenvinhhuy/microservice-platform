{
  "uid": "kafka-dashboard",
  "title": "Kafka Dashboard",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Kafka Consumer Lag",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        { "expr": "kafka_consumer_lag", "legendFormat": "lag" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Kafka Consumer Processing Latency (avg seconds)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(kafka_consumer_processing_latency_seconds_sum[5m]) / rate(kafka_consumer_processing_latency_seconds_count[5m])",
          "legendFormat": "avg"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Retry and DLQ (rate)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(rate(kafka_consumer_retry_total[5m]))", "legendFormat": "retry" },
        { "expr": "sum(rate(kafka_consumer_dlq_total[5m]))", "legendFormat": "dlq" }
      ]
    }
  ]
}

